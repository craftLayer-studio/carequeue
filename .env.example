# Copy to .env.local for local overrides. Never commit real values.

# Public base URL used in QR codes and WhatsApp links.
# Production: https://carequeue.craftlayer.store  Dev: http://localhost:3101
APP_URL=http://localhost:3101

# Signs the staff session cookie. Use a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: use a real Postgres instead of the local PGlite file DB in ./.data/pglite
# DATABASE_URL=postgres://user:password@localhost:5432/carequeue

# Set to 0 to stop auto-seeding an empty dev database with the demo clinic.
# CAREQUEUE_AUTOSEED=1
